{
  "doc_type": "api",
  "title": "NebulaLab 实验编排平台 API 文档",
  "ignored_slots": [
    "entities",
    "schemas"
  ],
  "entities": [
    {
      "name": "NebulaLab实验编排平台",
      "entity_type": "system"
    },
    {
      "name": "研究者",
      "entity_type": "actor"
    },
    {
      "name": "传感器",
      "entity_type": "data"
    }
  ],
  "endpoints": [
    {
      "name": "获取访问令牌",
      "http_method": "post",
      "path": "/auth/token",
      "summary": "获取访问令牌"
    },
    {
      "name": "创建实验项目",
      "http_method": "post",
      "path": "/projects",
      "summary": "创建实验项目"
    },
    {
      "name": "查询项目列表",
      "http_method": "get",
      "path": "/projects",
      "summary": "查询项目列表"
    },
    {
      "name": "批量创建样本",
      "http_method": "post",
      "path": "/projects/{project_id}/samples/batch",
      "summary": "批量创建样本"
    },
    {
      "name": "获取样本详情",
      "http_method": "get",
      "path": "/samples/{sample_id}",
      "summary": "获取样本详情"
    },
    {
      "name": "注册设备",
      "http_method": "post",
      "path": "/devices",
      "summary": "注册设备"
    },
    {
      "name": "查询设备状态",
      "http_method": "get",
      "path": "/devices/{device_id}/status",
      "summary": "查询设备状态"
    },
    {
      "name": "创建实验任务",
      "http_method": "post",
      "path": "/experiments",
      "summary": "创建实验任务"
    },
    {
      "name": "上传传感器数据",
      "http_method": "post",
      "path": "/experiments/{experiment_id}/data-points",
      "summary": "上传传感器数据"
    },
    {
      "name": "创建分析任务",
      "http_method": "post",
      "path": "/experiments/{experiment_id}/analysis-jobs",
      "summary": "创建分析任务"
    },
    {
      "name": "查询审计日志",
      "http_method": "get",
      "path": "/audit-logs",
      "summary": "查询审计日志"
    },
    {
      "name": "注册Webhook",
      "http_method": "post",
      "path": "/webhooks",
      "summary": "注册Webhook"
    },
    {
      "name": "启动实验 (7.2)",
      "http_method": "post",
      "path": "/experiments/{experiment_id}/start",
      "summary": "启动实验任务"
    },
    {
      "name": "暂停实验 (7.3)",
      "http_method": "post",
      "path": "/experiments/{experiment_id}/pause",
      "summary": "暂停实验任务"
    },
    {
      "name": "终止实验 (7.4)",
      "http_method": "post",
      "path": "/experiments/{experiment_id}/abort",
      "summary": "终止实验任务"
    },
    {
      "name": "查询分析结果 (9.2)",
      "http_method": "get",
      "path": "/analysis-jobs/{analysis_job_id}",
      "summary": "查询分析任务结果"
    },
    {
      "name": "查询实验数据 (8.2)",
      "http_method": "get",
      "path": "/experiments/{experiment_id}/data-points",
      "summary": "查询实验数据点"
    }
  ],
  "schemas": [],
  "auth": [
    {
      "name": "Bearer Token",
      "auth_type": "Bearer",
      "description": "通过访问令牌进行接口认证"
    }
  ]
}