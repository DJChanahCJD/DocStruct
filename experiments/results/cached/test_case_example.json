{
  "doc_type": "test",
  "title": "电商平台功能测试用例集",
  "extra": {},
  "entities": [],
  "test_cases": [
    {
      "id": "TC-001",
      "name": "验证用户使用有效手机号成功注册",
      "evidence_element_ids": [
        "el-0005",
        "el-0006",
        "el-0007"
      ],
      "precondition": "1. 用户未注册过账号\n2. 测试环境可正常访问\n3. 短信验证码服务可用",
      "expected_result": "1. 页面成功跳转到注册成功提示页\n2. 系统自动发送欢迎短信\n3. 数据库中新增一条用户记录，状态为\"已激活\"\n4. 用户可使用该手机号和密码正常登录"
    },
    {
      "id": "TC-002",
      "name": "验证已注册用户通过手机号密码登录",
      "evidence_element_ids": [
        "el-0015",
        "el-0016",
        "el-0017"
      ],
      "precondition": "1. 用户已注册且账号状态正常\n2. 已知正确的手机号和密码",
      "expected_result": "1. 页面跳转到系统首页\n2. 页面右上角显示用户昵称\n3. 本地存储生成有效的登录 Token\n4. 记录登录日志（时间、IP地址）"
    },
    {
      "id": "TC-003",
      "name": "验证通过关键词搜索商品返回正确结果",
      "evidence_element_ids": [
        "el-0025",
        "el-0026",
        "el-0027"
      ],
      "precondition": "1. 系统中存在商品数据\n2. 存在商品名称为\"iPhone 15 Pro\"的商品",
      "expected_result": "1. 页面显示搜索结果列表\n2. 结果中包含\"iPhone 15 Pro\"等相关商品\n3. 搜索结果按相关度排序\n4. 页面显示搜索结果总数\n5. 支持分页展示（如结果超过20条）"
    },
    {
      "id": "TC-004",
      "name": "验证用户可将商品加入购物车",
      "evidence_element_ids": [
        "el-0035",
        "el-0036",
        "el-0037"
      ],
      "precondition": "1. 用户已登录\n2. 目标商品库存充足（库存 > 10）",
      "expected_result": "1. 页面显示\"已成功加入购物车\"提示\n2. 购物车图标右上角数字增加 2\n3. 购物车页面显示该商品信息（名称、规格、数量、单价）\n4. 购物车小计金额计算正确"
    },
    {
      "id": "TC-005",
      "name": "验证用户可从购物车创建订单",
      "evidence_element_ids": [
        "el-0045",
        "el-0046",
        "el-0047"
      ],
      "precondition": "1. 用户已登录\n2. 购物车中存在商品\n3. 用户已设置默认收货地址",
      "expected_result": "1. 页面跳转到订单确认页\n2. 显示订单号（格式：O20240120123456）\n3. 订单状态为\"待支付\"\n4. 库存相应扣减（预占库存）\n5. 购物车中对应商品被清除\n6. 订单详情页可查看完整订单信息"
    },
    {
      "id": "TC-006",
      "name": "验证用户可完成订单支付",
      "evidence_element_ids": [
        "el-0055",
        "el-0056",
        "el-0057"
      ],
      "precondition": "1. 存在待支付的订单\n2. 用户余额充足或已绑定支付方式",
      "expected_result": "1. 页面显示\"支付成功\"\n2. 订单状态更新为\"已支付\"\n3. 支付记录生成，包含支付时间、支付单号\n4. 用户收到支付成功通知（站内信+短信）\n5. 商家端收到新订单提醒"
    },
    {
      "id": "TC-007",
      "name": "验证连续输入错误密码后账号锁定",
      "evidence_element_ids": [
        "el-0065",
        "el-0066",
        "el-0067"
      ],
      "precondition": "1. 用户已注册且账号状态正常\n2. 已知正确的手机号",
      "expected_result": "1. 前5次提示\"密码错误，还剩X次机会\"\n2. 第6次提示\"账号已锁定，请15分钟后重试\"\n3. 账号状态变为\"临时锁定\"\n4. 15分钟内无法通过正确密码登录\n5. 15分钟后自动解锁，可用正确密码登录"
    },
    {
      "id": "TC-008",
      "name": "验证商品库存不足时的处理",
      "evidence_element_ids": [
        "el-0075",
        "el-0076",
        "el-0077"
      ],
      "precondition": "1 目标商品库存为 1",
      "expected_result": "1. 用户B进入商品详情页时显示\"库存紧张\"\n2. 用户B尝试加入购物车时提示\"库存不足\"\n3. 用户A取消订单后，库存释放\n4. 库存释放后用户B可正常购买"
    },
    {
      "id": "TC-009",
      "name": "验证订单可使用符合条件的优惠券",
      "evidence_element_ids": [
        "el-0085",
        "el-0086",
        "el-0087"
      ],
      "precondition": "1. 用户持有有效的优惠券（满100减20）\n2. 购物车商品总金额 >= 100元",
      "expected_result": "1. 优惠券列表显示可用优惠券\n2. 选择优惠券后，订单金额显示为 100元（120-20）\n3. 优惠券状态变为\"已使用\"\n4. 订单详情显示使用的优惠券信息"
    },
    {
      "id": "TC-010",
      "name": "验证用户可取消待支付订单",
      "evidence_element_ids": [
        "el-0095",
        "el-0096",
        "el-0097"
      ],
      "precondition": "1 存在状态为\"待支付\"的订单",
      "expected_result": "1. 弹出确认对话框\n2. 取消成功后订单状态变为\"已取消\"\n3. 预占的库存被释放\n4. 使用的优惠券退回（状态变回\"未使用\"）\n5. 订单列表显示该订单为已取消状态"
    }
  ],
